// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id Int @id @default(autoincrement())
  nome String
  ativo Boolean @default(true)

  qualificacoes Qualificacao[]
  indisponibilidades Indisponibilidade[]

  @@map("pessoa")
}

model Culto {
  id Int @id @default(autoincrement())
  nome String
  data DateTime
  indisponibilidades Indisponibilidade[]

  @@map("culto")
}

model Indisponibilidade {
  pessoa Pessoa @relation(fields: [pessoaId], references: [id])
  culto Culto @relation(fields: [cultoId], references: [id])

  cultoId Int 
  pessoaId Int

  @@map("indisponibilidade")
  @@id([pessoaId, cultoId])
}

model Funcao {
  id Int @id @default(autoincrement())
  nome String
  ministerio Ministerio @relation(fields: [ministerioId], references: [id], onDelete: Cascade)
  ministerioId Int

  qualificacoes Qualificacao[]

  @@map("funcao")
}

model Ministerio {
  id Int @id @default(autoincrement())
  nome String
  funcoes Funcao[]

  @@map("ministerio")
}

model Qualificacao {
  pessoa Pessoa @relation(fields: [pessoaId], references: [id])
  funcao Funcao @relation(fields: [funcaoId], references: [id], onDelete: Cascade)

  funcaoId Int
  pessoaId Int

  @@map("qualificacao")
  @@id([pessoaId, funcaoId])
}
