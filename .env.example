# Lido APENAS pelo docker-compose.yml (interpolação ${VAR}).
# Copie para /.env e preencha. /.env nunca é versionado (.gitignore).
# Na VPS: use segredos reais, fortes e diferentes destes.

# Senha do Postgres. Usada em dois lugares pelo compose:
#   - POSTGRES_PASSWORD do serviço `postgres`
#   - montada na DATABASE_URL injetada no serviço `api`
# Se for rodar a API no host, repita este valor em api/.env (DATABASE_URL).
DB_PASSWORD=

# Hash bcrypt do basicauth do Caddy (serviço `caddy` -> {$ADMIN_PASSWORD_HASH} no Caddyfile).
# Sem valor, o basicauth do Caddy falha fechado (nega acesso) — nunca abre sozinho.
# Gerar (com Docker rodando):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'suasenha'
# Colar o resultado (começa com $2a$...) aqui:
ADMIN_PASSWORD_HASH=

# Hostname que o Caddy atende (serviço `caddy` -> {$CADDY_SITE_ADDRESS} no Caddyfile).
# Local: http://localhost  (o http:// explícito evita o Caddy tentar TLS em "localhost")
# VPS:   escalador.icnvanil.com.br
CADDY_SITE_ADDRESS=http://localhost
